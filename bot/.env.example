# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# ID администраторов через запятую
ADMIN_IDS=123456789

# Файл базы данных
DB_PATH=bot.sqlite3

# Имя бота для кнопки «Поделиться» (без @)
BOT_USERNAME=diyordestorebot

# Время на оплату заказа, минут
ORDER_TTL_MINUTES=15

# Ссылки разделов меню
SUPPORT_URL=https://t.me/diyordestore_support
NEWS_URL=https://t.me/diyordestore
MANUAL_URL=https://t.me/diyordestore/2

# PayPalych (необязательно; без токена кнопка СБП сообщит, что оплата недоступна)
PAYPALYCH_TOKEN=
PAYPALYCH_SHOP_ID=
PAYPALYCH_API=https://paypalych.com/api/v1
